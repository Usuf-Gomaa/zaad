# Caddy >= 2.8. Populate protected service environment before validation/start.
# Public and reviewer roots MUST be separate immutable artifacts, never the repository.
{$ZAAD_PUBLIC_DOMAIN} {
  handle_errors {
    header {
      Cache-Control "no-cache"
      Strict-Transport-Security "max-age=31536000"
      X-Content-Type-Options nosniff
      Referrer-Policy no-referrer
      Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
    }
    respond "{err.status_text}" {err.status_code}
  }
  route {
    header -Server
    header {
      Strict-Transport-Security "max-age=31536000"
      X-Content-Type-Options nosniff
      Referrer-Policy no-referrer
      Permissions-Policy "camera=(), microphone=(), geolocation=()"
      Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
      Cache-Control "no-cache"
    }
    @nonRead not method GET HEAD
    respond @nonRead 405
    @private path /review /review/* /review-build.json /review-manifest-en.webmanifest /.git/* /docs/*
    respond @private 404
    root * /srv/zaad/public/current
    @hashed path /assets/*
    header @hashed Cache-Control "public, max-age=31536000, immutable"
    @worker path /sw.js
    header @worker Service-Worker-Allowed "/"
    @asset path_regexp asset \.[^/]+$
    handle @asset {
      try_files {path} =404
      file_server
    }
    handle {
      rewrite * /index.html
      file_server
    }
  }
}

{$ZAAD_REVIEW_DOMAIN} {
  handle_errors {
    header {
      Cache-Control "private, no-store"
      Vary Authorization
      Strict-Transport-Security "max-age=31536000"
      X-Content-Type-Options nosniff
      Referrer-Policy no-referrer
      X-Robots-Tag "noindex, nofollow, noarchive"
      Content-Security-Policy "default-src 'none'; worker-src 'none'; frame-ancestors 'none'"
    }
    respond "{err.status_text}" {err.status_code}
  }
  route {
    header -Server
    # Headers also cover authentication failures. Never enable a shared CDN cache.
    header {
      Strict-Transport-Security "max-age=31536000"
      X-Content-Type-Options nosniff
      Referrer-Policy no-referrer
      Permissions-Policy "camera=(), microphone=(), geolocation=()"
      X-Robots-Tag "noindex, nofollow, noarchive"
      Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
      Cache-Control "private, no-store"
      Vary Authorization
    }
    # Protect every path, including chunks, manifests, errors and SPA routes.
    basic_auth {
      {$ZAAD_REVIEW_USER} {$ZAAD_REVIEW_PASSWORD_HASH}
    }
    @nonRead not method GET HEAD
    respond @nonRead 405
    root * /srv/zaad/review/current
    # Remote review deliberately has no service worker or install manifest.
    @offline path /sw.js /manifest.webmanifest /manifest-en.webmanifest /review-manifest-en.webmanifest
    respond @offline 404
    @asset path_regexp reviewasset \.[^/]+$
    handle @asset {
      try_files {path} =404
      file_server
    }
    handle {
      rewrite * /index.html
      file_server
    }
  }
}
